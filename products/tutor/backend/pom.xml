<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.6</version>
        <relativePath/>
    </parent>

    <groupId>com.studioengine</groupId>
    <artifactId>tutor-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>tutor-backend</name>
    <description>White-label single-provider appointment scheduling engine</description>

    <modules>
        <module>dataaccess</module>
        <module>core</module>
        <module>api</module>
        <module>app</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <mapstruct.version>1.5.5.Final</mapstruct.version>
        <lombok-mapstruct-binding.version>0.2.0</lombok-mapstruct-binding.version>
        <!-- PDF invoice generation (Apache 2.0 license, no AGPL risk) -->
        <pdfbox.version>3.0.4</pdfbox.version>
        <!-- QR/2D barcode generation for Croatian HUB3 payment slips -->
        <zxing.version>3.5.3</zxing.version>
        <!-- .ics calendar file generation for email attachments -->
        <ical4j.version>4.0.7</ical4j.version>
        <!-- Payment processing provider SDK -->
        <stripe.version>28.2.0</stripe.version>
        <!-- JWT creation and HMAC signature verification -->
        <nimbus-jose.version>9.47</nimbus-jose.version>
        <!-- Distributed lock for scheduled tasks (prevents duplicate execution) -->
        <shedlock.version>6.0.2</shedlock.version>
        <!-- Property-based testing framework (JUnit 5 compatible) -->
        <jqwik.version>1.9.2</jqwik.version>
        <!-- Docker-based integration testing (PostgreSQL container) -->
        <testcontainers.version>2.0.5</testcontainers.version>

        <!-- Vulnerability overrides -->
        <postgresql.version>42.7.11</postgresql.version>
        <tomcat.version>11.0.22</tomcat.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.studioengine</groupId>
                <artifactId>tutor-dataaccess</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.studioengine</groupId>
                <artifactId>tutor-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.studioengine</groupId>
                <artifactId>tutor-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.mapstruct</groupId>
                <artifactId>mapstruct</artifactId>
                <version>${mapstruct.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>

                    <configuration>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok-mapstruct-binding</artifactId>
                                <version>${lombok-mapstruct-binding.version}</version>
                            </path>
                            <path>
                                <groupId>org.mapstruct</groupId>
                                <artifactId>mapstruct-processor</artifactId>
                                <version>${mapstruct.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
                <!-- Dependency vulnerability scanning against NVD (run: ./mvnw dependency-check:check) -->
                <plugin>
                    <groupId>org.owasp</groupId>
                    <artifactId>dependency-check-maven</artifactId>
                    <version>11.1.1</version>
                    <configuration>
                        <failBuildOnCVSS>7</failBuildOnCVSS>
                        <ossindexAnalyzerEnabled>false</ossindexAnalyzerEnabled>
                        <suppressionFiles>
                            <suppressionFile>dependency-check-suppression.xml</suppressionFile>
                        </suppressionFiles>
                    </configuration>
                </plugin>
                <!-- Code coverage reporting (run: ./mvnw verify, report at app/target/site/jacoco-aggregate/) -->
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.12</version>
                    <executions>
                        <execution>
                            <id>prepare-agent</id>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                        <execution>
                            <id>report</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>report</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <excludes>
                            <exclude>**/dto/**</exclude>
                            <exclude>**/config/**</exclude>
                            <exclude>**/errors/**</exclude>
                            <exclude>**/enums/**</exclude>
                            <exclude>**/entities/**</exclude>
                            <exclude>**/*Application.*</exclude>
                        </excludes>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
